# --- LLM provider switch -----------------------------------------------
# "ollama" (default): free, runs on your laptop, health data never leaves it.
# "groq": free hosted tier (console.groq.com), much stronger models
#         (Llama 3.3 70B) than practical to self-host, still no cost.
# "openai": strongest reasoning, costs money, data sent to OpenAI.
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama, and always used for embeddings
# when LLM_PROVIDER=groq, since Groq has no embeddings endpoint)
# On Docker Desktop (Mac/Windows) host.docker.internal works out of the box.
# On Linux, uncomment extra_hosts in docker-compose.yml first.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq — free key at https://console.groq.com/keys, no card required
# (as of this writing; check current terms). OpenAI-compatible API.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (used when LLM_PROVIDER=openai, or per-service override later)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Everything else -----------------------------------------------------
DATABASE_URL=postgresql://nutrifyai:nutrifyai_dev_password@localhost:5432/nutrifyai
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-string
BACKEND_CORE_URL=http://backend-core:8080/api/v1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nutrifyai-dev
