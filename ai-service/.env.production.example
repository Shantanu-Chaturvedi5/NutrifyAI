# Copy to ai-service/.env.production and fill in real values.
# MUST match backend-core/.env.production's AI_SERVICE_INTERNAL_TOKEN exactly.

LLM_PROVIDER=groq
AI_SERVICE_INTERNAL_TOKEN=

# Ollama — only relevant if LLM_PROVIDER=ollama, or always for embeddings
# (Groq has no embeddings endpoint, so this is used regardless of
# LLM_PROVIDER when it comes to embedding text).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq — free tier, recommended default for a public deployment: much
# better reasoning than a small local model, and no server-side GPU to
# provision. See the earlier discussion in this project on Ollama vs.
# Groq vs. OpenAI for why this is the suggested production default.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
