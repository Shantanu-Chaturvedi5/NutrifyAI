# Copy to backend-core/.env.production and fill in real values.
# Generate strong random secrets with: openssl rand -base64 48

JWT_SECRET=
AI_SERVICE_INTERNAL_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Optional — leave blank to keep OAuth2 login disabled in production too
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
