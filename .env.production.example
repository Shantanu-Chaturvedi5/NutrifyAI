# Production secrets. Copy to .env.production and fill in real values —
# never commit the filled-in version.
#
# Generate strong random values for anything below with:
#   openssl rand -base64 48

POSTGRES_DB=nutrifyai
POSTGRES_USER=nutrifyai
POSTGRES_PASSWORD=

# Optional stable free hostname. Register a subdomain at duckdns.org, then
# set the prefix in DUCKDNS_SUBDOMAIN (without ".duckdns.org"), the full
# hostname in APP_DOMAIN, and the account token in DUCKDNS_TOKEN.
# Required only when deploying with docker-compose.ddns.yml.
APP_DOMAIN=
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
